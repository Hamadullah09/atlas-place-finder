# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Nominatim + Overpass are free/community-run and REQUIRE a descriptive
# User-Agent with a way to contact you. Change this before deploying.
#
# WARNING: Nominatim returns 403 for any User-Agent containing a placeholder
# domain (example.com / example.org). Use a real URL or email, e.g.
#   HTTP_USER_AGENT=PlaceFinder/1.0 (+https://github.com/you/place-finder)
HTTP_USER_AGENT=PlaceFinder/1.0 (self-hosted; set HTTP_USER_AGENT to your contact URL)

# ---------------------------------------------------------------------------
# OpenStreetMap data sources (no key required)
# ---------------------------------------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.osm.ch/api/interpreter
OVERPASS_TIMEOUT_MS=90000
MAX_RESULTS=60

# ---------------------------------------------------------------------------
# Imagery
# ---------------------------------------------------------------------------
# Sources are tried in descending order of "certain to depict this exact place":
#   1. Wikidata P18            2. Wikipedia lead image
#   3. Wikimedia Commons category (usually the biggest haul for a landmark)
#   4. Images embedded in the Wikipedia article
#   5. Commons free-text search  6. Openverse  7. Unsplash
# Only 6 and 7 need configuration; everything else is keyless.
UNSPLASH_ACCESS_KEY=
IMAGES_PER_PLACE=10
# Openverse aggregates ~700M CC-licensed images and needs no API key.
OPENVERSE_ENABLED=true
# Minimum pixel width for an image to count as "ultra HD"
MIN_IMAGE_WIDTH=1600

# ---------------------------------------------------------------------------
# Extra place-discovery sources (layered on top of Overpass)
# ---------------------------------------------------------------------------
# Wikidata SPARQL finds notable landmarks that have coordinates but no OSM node.
# Nominatim catches places whose NAME matches even when their tags don't.
DISCOVERY_WIKIDATA=true
DISCOVERY_NOMINATIM=true

# ---------------------------------------------------------------------------
# Travel marketplace deep links (Tripadvisor / Viator / GetYourGuide / Trip.com)
# ---------------------------------------------------------------------------
# These are constructed SEARCH URLS, not API integrations. None of these sites
# can act as a place-retrieval source here:
#   Viator + GetYourGuide  need partner approval and API certification
#   Trip.com               affiliate/partner programme
#   Tripadvisor            Content API is self-serve, but its terms cap caching
#                          at ONE HOUR and forbid pre-fetching your inventory,
#                          which rules out an offline PDF/ZIP export.
# Linking out breaks none of that, needs no key, and still gets users to
# reviews and bookings in one click.
# chinahighlights + travelchina only render for CN/HK/MO results, so they add
# nothing to a search elsewhere. travelchina.org.cn is a static portal with no
# search form at all, so its link is the portal itself, not a place lookup.
TRAVEL_PROVIDERS=tripadvisor,viator,getyourguide,tripcom,chinahighlights,travelchina

# Trip.com country storefront. `my.trip.com` is the Malaysia site — Trip.com
# uses country-code subdomains (www./us./uk./sg./my.), so this is one provider
# with a regional domain rather than a separate site.
TRIPCOM_DOMAIN=www.trip.com

# Optional affiliate parameters as `provider=param=value`, comma separated, e.g.
#   TRAVEL_AFFILIATE_TAGS=viator=pid=P00012345,getyourguide=partner_id=ABC
TRAVEL_AFFILIATE_TAGS=

# ---------------------------------------------------------------------------
# Long-form research for the PDF write-ups
# ---------------------------------------------------------------------------
# Pulls the full Wikipedia article, Wikivoyage entry and Wikidata statements
# for each place at DOWNLOAD time, then has the LLM write a multi-section entry
# grounded strictly in that material.
CONTENT_ENABLED=true
CONTENT_MAX_EXTRACT_CHARS=9000
CONTENT_WIKIVOYAGE=true

LLM_LONGFORM=true
LLM_LONGFORM_TIMEOUT_MS=240000
LLM_LONGFORM_MAX_TOKENS=1800
# Places written up in parallel. Keep at 1-2 for a local CPU model.
LLM_LONGFORM_CONCURRENCY=2

# How many images get embedded inside each PDF (the rest still ship as JPEGs).
PDF_EMBED_IMAGES=6

# ---------------------------------------------------------------------------
# Open-source LLM (OpenAI-compatible chat completions endpoint)
# ---------------------------------------------------------------------------
# Hugging Face Inference Router (default):
#   LLM_BASE_URL=https://router.huggingface.co/v1
#   LLM_API_KEY=hf_xxxxxxxxxxxxxxxxx
#   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Local Ollama (no GPU needed — every Ollama model runs on CPU):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:1.5b
#   LLM_BATCH_SIZE=4
#   LLM_TIMEOUT_MS=180000
#
# MEASURED ON A 4-CORE i5-4590 / 8 GB, "tourist places in Karachi":
#   qwen2.5:0.5b  Unusable. Emits bare objects instead of an array, flattens
#                 every score to 85-95 (destroying the ranking) and dropped the
#                 National Museum of Pakistan entirely.
#   qwen2.5:1.5b  Usable format and judgment, ~127 s per 10-result search, but
#                 STILL misreports facts: rewrote the tag "Th-Tu 10:00-17:00"
#                 as "Monday to Friday" even when told to copy verbatim.
#
# Those summaries are written into the downloadable PDFs, so a fabricated
# opening time becomes a fact in a file someone keeps. On modest hardware the
# rule-based cleaner (leave LLM_API_KEY empty) is more accurate AND ~10x faster;
# it only lacks the relevance filtering. Prefer a larger hosted model if you
# want the filtering without the fabrication.
#
# If LLM_API_KEY is empty the backend falls back to a deterministic
# rule-based cleaner, so the app still works end-to-end without a key.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
LLM_BATCH_SIZE=8
LLM_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Optional PostgreSQL cache / search history.
# Leave blank to use the built-in in-memory cache.
# ---------------------------------------------------------------------------
DATABASE_URL=
CACHE_TTL_MS=21600000

# ---------------------------------------------------------------------------
# PDF rendering
# ---------------------------------------------------------------------------
# pdfkit's built-in fonts are Latin-1 only. To render Urdu/Arabic/CJK place
# names, point these at .ttf files (e.g. Noto Sans / Noto Sans Arabic).
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=
