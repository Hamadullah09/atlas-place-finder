# Local export scratch
tmp/
*.zip

# Packaging output — each edition exe is ~60 MB, well past GitHub's limits.
# Rebuild them with `node build-exe.mjs`.
dist-exe/
pkg-stage/

# Batch run artefacts, in case anyone points the output at the repo.
_batch-state.json
_batch-report.txt

# Local embedding vector cache — regenerated on demand, machine-specific.
.embed-cache.json

# Eval output: timings and counts are specific to the machine and model that
# produced them. The harness and its fixture corpus ARE tracked, so anyone can
# regenerate these with `npm run eval`.
backend/src/eval/reports/

# Local agent/editor config
.claude/

# Tauri desktop shell: Rust build output and the server copied in at build time.
desktop/src-tauri/target/
desktop/src-tauri/resources/
# Generated by tauri at build time.
desktop/src-tauri/gen/
# `tauri icon` writes every platform's icons; the installer is Windows-only and
# tauri.conf.json references just the .ico and three PNGs. Regenerate with
# `npx tauri icon` if another platform is ever targeted.
desktop/src-tauri/icons/android/
desktop/src-tauri/icons/ios/
desktop/src-tauri/icons/icon.icns
desktop/src-tauri/icons/Square*Logo.png
desktop/src-tauri/icons/StoreLogo.png
desktop/src-tauri/icons/64x64.png
